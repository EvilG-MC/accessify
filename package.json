{
	"name": "accessify",
	"description": "A simple REST API to generate and cache anonymous Spotify access tokens using Playwright",
	"version": "1.0.0",
	"main": "dist/server.mjs",
	"type": "module",
	"private": true,
	"author": {
		"email": "kiyomi@mjba.my",
		"name": "iaMJ"
	},
	"license": "MIT",
	"lint-staged": {
		"*.ts": [
			"pnpm format"
		]
