		"hono": "^4.12.28",
		"playwright": "^1.61.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@types/node": "^26.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"tsdown": "^0.22.3",
		"typescript": "^6.0.3"
	}
}
